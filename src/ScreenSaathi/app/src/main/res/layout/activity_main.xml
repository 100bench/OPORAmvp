<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF0B0B0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Опора"
            android:textColor="@color/saathi_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Помощник ориентируется по открытому экрану. Контакт ниже нужен только для звонка и на работу подсказок не влияет."
            android:textColor="@color/saathi_text_dim"
            android:textSize="15sp"
            android:paddingTop="6dp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="1. Разрешить показ поверх окон"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <Button
            android:id="@+id/btn_mic"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="2. Разрешить микрофон"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="3. Включить чтение экрана"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <Button
            android:id="@+id/btn_call"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="4. Разрешить звонок после подтверждения"
            android:textColor="#FFFFFFFF"
            android:backgroundTint="@color/saathi_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Контакт для звонка (необязательно)"
            android:textColor="@color/saathi_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/contact_name"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/field_bg"
            android:hint="Имя контакта, например Мама"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:textColor="#FF101010"
            android:textColorHint="#88101010" />

        <EditText
            android:id="@+id/contact_phone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/field_bg"
            android:hint="Телефон, например +79991234567"
            android:inputType="phone"
            android:paddingHorizontal="14dp"
            android:textColor="#FF101010"
            android:textColorHint="#88101010" />

        <Button
            android:id="@+id/btn_save_targets"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Сохранить контакт" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:text="Запустить помощника"
            android:textStyle="bold"
            android:textColor="#FF0B0B0F"
            android:backgroundTint="@color/saathi_highlight" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/saathi_text_dim"
            android:textSize="14sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
