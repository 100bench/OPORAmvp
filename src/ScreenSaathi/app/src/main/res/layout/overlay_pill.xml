<?xml version="1.0" encoding="utf-8"?>
<!-- The window is 96dp for the mascot and 346dp for the open card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/opora_bubble_bg"
        android:elevation="12dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="96dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pill_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Опора"
                android:textColor="@color/opora_card_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/language_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Русский"
                android:textColor="@color/opora_card_subtext"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/close_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/opora_secondary_bg"
                android:clickable="true"
                android:contentDescription="Свернуть Опору"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/opora_brand_strong"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:minHeight="48dp"
            android:text="Нажмите на микрофон и скажите, что нужно сделать."
            android:textColor="@color/opora_card_text"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/choice_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/choice_0" style="@style/OporaChoice" android:layout_marginVertical="4dp" />
            <TextView android:id="@+id/choice_1" style="@style/OporaChoice" android:layout_marginVertical="4dp" />
            <TextView android:id="@+id/choice_2" style="@style/OporaChoice" android:layout_marginVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/decision_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/decision_secondary_button" style="@style/OporaSecondaryAction" android:text="@string/decision_stop" />
            <TextView android:id="@+id/decision_primary_button" style="@style/OporaPrimaryAction" android:layout_marginStart="8dp" android:text="@string/decision_continue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text_command_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/text_command"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="Напишите вопрос"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingHorizontal="12dp"
                android:textColor="@color/opora_card_text"
                android:textColorHint="@color/opora_card_subtext"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/send_text_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:minHeight="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/opora_primary_bg"
                android:gravity="center"
                android:text="Отправить"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/voice_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:id="@+id/transport_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/mic_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/mic_circle_bg"
                    android:clickable="true"
                    android:contentDescription="@string/mic_label"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_mic" />
                <TextView
                    android:id="@+id/next_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/opora_secondary_bg"
                    android:gravity="center"
                    android:text="Что дальше?"
                    android:textColor="@color/opora_brand_strong"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/stop_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/opora_secondary_bg"
                    android:contentDescription="Остановить помощь"
                    android:gravity="center"
                    android:text="■"
                    android:textColor="@color/opora_brand_strong"
                    android:textSize="13sp" />
            </LinearLayout>
            <com.screensaathi.overlay.VoiceWaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/removal_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Убрать Опору?"
                android:textColor="@color/opora_card_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Помощь завершится. Кружок вернётся при следующем запуске Опоры."
                android:textColor="@color/opora_card_subtext"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/removal_cancel_button"
                    style="@style/OporaSecondaryAction"
                    android:text="Отмена" />
                <TextView
                    android:id="@+id/removal_confirm_button"
                    style="@style/OporaPrimaryAction"
                    android:layout_marginStart="8dp"
                    android:text="Убрать" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/debug_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/opora_card_subtext"
            android:textSize="11sp"
            android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/minimized_dot"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:clickable="true"
        android:contentDescription="Открыть Опору"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/opora_mascot"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/pill_row"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:clickable="true"
        android:contentDescription="Открыть Опору"
        android:elevation="16dp"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/opora_mascot" />
</FrameLayout>
