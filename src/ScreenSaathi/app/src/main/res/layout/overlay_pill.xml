<?xml version="1.0" encoding="utf-8"?>
<!-- Opora overlay translated from the supplied Figma composition. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/opora_overlay_card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/opora_orb_bg">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/opora_agent_face" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Опора"
                android:textColor="@color/opora_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/close_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/opora_close_bg"
                android:clickable="true"
                android:contentDescription="Свернуть помощника"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/opora_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/instruction_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:text="Скажите, что нужно сделать. Я объясню следующий шаг."
            android:textColor="@color/opora_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/choice_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/choice_0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/opora_primary_button_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/choice_1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/opora_primary_button_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/choice_2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/opora_primary_button_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/confirmation_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/decline_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/opora_secondary_button_bg"
                android:gravity="center"
                android:text="Отказаться"
                android:textColor="@color/opora_brand_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confirm_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/opora_primary_button_bg"
                android:gravity="center"
                android:text="Подтвердить"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text_command_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/text_command"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:hint="Напишите вопрос"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingHorizontal="14dp"
                android:textColor="@color/opora_ink"
                android:textColorHint="#8849544F"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/send_text_button"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/opora_primary_button_bg"
                android:gravity="center"
                android:text="→"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/voice_slot"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/transport_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/opora_mint_circle">

                    <ImageView
                        android:id="@+id/mic_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="@string/mic_label"
                        android:focusable="true"
                        android:padding="14dp"
                        android:src="@drawable/opora_mic" />
                </FrameLayout>

                <TextView
                    android:id="@+id/next_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/opora_secondary_button_bg"
                    android:gravity="center"
                    android:text="Что дальше?"
                    android:textColor="@color/opora_brand_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stop_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/opora_secondary_button_bg"
                    android:gravity="center"
                    android:text="■"
                    android:textColor="@color/opora_ink_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.screensaathi.overlay.VoiceWaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/debug_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="@color/opora_ink_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/collapsed_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/opora_overlay_menu_bg"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/open_assistant_button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/opora_primary_button_bg"
            android:gravity="center"
            android:minWidth="188dp"
            android:paddingHorizontal="16dp"
            android:text="Открыть помощника"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/dismiss_assistant_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/opora_close_bg"
            android:contentDescription="Убрать иконку"
            android:padding="12dp"
            android:src="@drawable/opora_close" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/minimized_dot"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/opora_orb_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/opora_agent_face" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pill_row"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/opora_overlay_pill_bg"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/opora_orb_bg">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/opora_agent_face" />

            <com.screensaathi.overlay.StateOrbView
                android:id="@+id/state_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="end|bottom" />
        </FrameLayout>

        <TextView
            android:id="@+id/pill_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Опора"
            android:textColor="@color/opora_brand_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/language_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/opora_close_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Русский"
            android:textColor="@color/opora_brand_dark"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
