<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.FixtureExportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.screensaathi.EXPORT_UI_FIXTURE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.TextProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.screensaathi.SUBMIT_TEXT_PROBE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.SemanticProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.screensaathi.PROBE_UI_SEMANTICS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
