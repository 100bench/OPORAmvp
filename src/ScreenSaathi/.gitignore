build/
.gradle/
.gradle-user-home/
.kotlin/
*.apk
*.aab
*.ap_
*.dex
captures/

# Generated smoke-test artifacts
scripts/*.wav

# IDE
.idea/
*.iml
.DS_Store

# Generated eval reports. The committed artefact is the baseline in
# evals/baselines/, not each run's output.
eval-results/
